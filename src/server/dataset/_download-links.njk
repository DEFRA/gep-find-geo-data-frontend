{% from "govuk/components/table/macro.njk" import govukTable %}

<div class="app-dataset-data__section">
  <h3 class="govuk-heading-s app-dataset-data__heading">Download this data</h3>
  <p class="govuk-body govuk-!-margin-top-2">The files below all contain the same information, saved in different formats so you can open it in the software you already use.</p>

  {% set downloadRows = [] %}
  {% for link in downloadLinks %}
    {% set dlHtml %}<a href="download/{{ record.id }}/{{ link.name | urlencode }}" class="govuk-link" download>Download<span class="govuk-visually-hidden"> {{ link.name }}</span></a>{% endset %}
    {% set downloadRows = (downloadRows.push([
      { text: link.name, classes: "app-dataset-data__name" },
      { text: link.format, classes: "app-dataset-data__col--fit" },
      { html: dlHtml, classes: "app-dataset-data__col--action" }
    ]), downloadRows) %}
  {% endfor %}

  {{ govukTable({
    head: [
      { html: '<span class="govuk-visually-hidden">File</span>' },
      { text: "Format", classes: "app-dataset-data__col--fit" },
      { text: "Action", classes: "app-dataset-data__col--action" }
    ],
    rows: downloadRows
  }) }}
</div>
